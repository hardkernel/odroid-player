#!/bin/sh

set -e

ln -sf /usr/bin/odroid-player-python/bin/odroid-player-client-oled \
       /usr/bin/odroid-player-client-oled
ln -sf /usr/bin/odroid-player-python/bin/odroid-player-client-web \
       /usr/bin/odroid-player-client-web

. /usr/share/debconf/confmodule

db_input high odroid-player/installed || true
db_go || true

